{
  "name": "asc-ehr",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @asc/db db:migrate",
    "db:generate": "pnpm --filter @asc/db db:generate"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20"
  }
}
