  "cards": [
    {
      "dot": "cyan",
      "title": "Tenant first",
      "items": [
        "Middleware maps the subdomain to a tenant before any login step",
        "startLogin is pinned to that tenant's projectId with a PKCE challenge",
        "apps/api checks the token's project matches the host tenant"
      ]
    },
    {
      "dot": "rose",
      "title": "Token rules (LM-004)",
      "items": [
        "Access token: JS memory only, short (target 15 min), sent as Bearer",
        "Refresh token: encrypted httpOnly cookie, path /auth, ≤ 12 h absolute",
        "Logout: Medplum logout + clear cookie + clear query cache"
      ]
    },
    {
      "dot": "violet",
      "title": "MFA and step-up",
      "items": [
        "With SSO, the hospital IdP owns MFA; otherwise Medplum TOTP is mandatory",
        "Signing, attesting, break-glass and admin need a login within 5 min",
        "401 step_up_required triggers prompt=login; the action is allowed once"
      ]
    }
  ]
