  "cards": [
    {
      "dot": "cyan",
      "title": "Five independent gates",
      "items": [
        "1 Tenant: host maps to an active tenant (404 unknown host)",
        "2 Identity: token valid, membership active, token Project == tenant (401)",
        "3 Facility: case facility in principal.facilities (403)",
        "4 Capability + workflow: can(note.sign), case state, step-up (403 / 409 / 401)",
        "5 Data policy: Medplum AccessPolicy on every FHIR call (403)"
      ]
    },
    {
      "dot": "rose",
      "title": "Any denial stops the request",
      "items": [
        "A failure at any gate returns its status code to apps/web",
        "Denials are audited with outcome 'denied' and the gate number",
        "Code checks only principal.capabilities, never role names"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gate 5 is the safety net",
      "items": [
        "The handler calls Medplum with the user's token, not a service token",
        "Even if gates 3–4 had a bug, Medplum would still refuse",
        "Gates 3–4 give clear errors, workflow rules and non-FHIR checks"
      ]
    }
  ]
