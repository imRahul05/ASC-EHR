# Web Staging Environment
APP_ENV=staging
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api-staging.ascehr.internal
# Real API: keep mocking off (only a hosted demo sets NEXT_PUBLIC_API_MOCKING=enabled).

# Medplum sign-in (used from P05j). Inlined at build time; a deployed build must set both.
# NEXT_PUBLIC_MEDPLUM_BASE_URL=https://<medplum-api-host>
# NEXT_PUBLIC_MEDPLUM_CLIENT_ID=<web-client-application-id>
