# Base URL the browser calls for apps/api (inlined at build time).
# Production builds fail if it is unset. See docs/DEPLOYMENT_CONFIGURATION.md.
NEXT_PUBLIC_API_URL=http://localhost:4000
# MSW API mocks: ON by default in development, OFF in production builds.
# Development: set to "disabled" to call a real apps/api instead.
# Production (hosted demo only): set to "enabled" to serve the mock API.
# NEXT_PUBLIC_API_MOCKING=disabled
# Medplum sign-in (used from P05j). Local: `pnpm medplum:up` then `pnpm medplum:seed`;
# the client id is the "asc-ehr-web" application in apps/bots/.seed-output.json.
# There is no localhost default in code: a deployed build must set both.
# NEXT_PUBLIC_MEDPLUM_BASE_URL=http://localhost:8203
# NEXT_PUBLIC_MEDPLUM_CLIENT_ID=
