# API Staging Environment
APP_ENV=staging
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Web app origin(s) allowed by CORS (comma-separated, exact)
CORS_ORIGINS=https://staging.ascehr.internal

# Redis & Data (Staging instances)
REDIS_URL=rediss://default:<staging_password>@<staging-redis-host>:6379
DATABASE_URL=postgresql://<staging_user>:<staging_password>@<staging-db-host>:5432/asc_ehr_staging?sslmode=require
# Runtime role (asc_runtime member, TLS): not the owner. DATABASE_URL above is the owner, for migrations only.
# DATABASE_RUNTIME_URL=postgresql://<staging_runtime_user>:<staging_runtime_password>@<staging-db-host>:5432/asc_ehr_staging?sslmode=require
# DEFAULT_TENANT_ID=<tenant-uuid>
# MEDPLUM_PROJECT_ID=<medplum-project-id>

# AI Provider Keys (Staging organization / capped keys)
OPENAI_API_KEY=sk-proj-staging-...
ANTHROPIC_API_KEY=sk-ant-staging-...
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# Agent Staging Flags
USE_BUDGET_MODELS=true

# Observability (validated by @asc/config env schemas)
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-collector-host>:4318
