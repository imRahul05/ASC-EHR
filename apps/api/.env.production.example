# API Production Environment (HIPAA & BAA Enforced)
APP_ENV=production
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Web app origin(s) allowed by CORS (comma-separated, exact)
CORS_ORIGINS=https://app.ascehr.com

# Redis & Data (Production instances with TLS and Auth)
REDIS_URL=rediss://default:<prod_password>@<prod-redis-host>:6379
DATABASE_URL=postgresql://<prod_user>:<prod_password>@<prod-db-host>:5432/asc_ehr_production?sslmode=require
# Runtime role (asc_runtime member, TLS): not the owner. DATABASE_URL above is the owner, for migrations only.
DATABASE_RUNTIME_URL=postgresql://<prod_runtime_user>:<prod_runtime_password>@<prod-db-host>:5432/asc_ehr_production?sslmode=require
# REQUIRED. The API refuses to start without a runtime database URL (durable, append-only audit store),
# the configured tenant and its Medplum Project. It also refuses to start until the Medplum identity
# adapter exists (P05i): the dev-only fake is never accepted here.
DEFAULT_TENANT_ID=<tenant-uuid>
MEDPLUM_PROJECT_ID=<medplum-project-id>
# Build id recorded in audit decisions (set from the deploy pipeline).
GIT_SHA=<git-sha>
# Flood limits per window: per tenant and address (before authentication), per tenant and user.
# RATE_LIMIT_IP_MAX=1200
# RATE_LIMIT_USER_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# AI Provider Keys (Production Enterprise accounts with BAA and Zero Data Retention)
OPENAI_API_KEY=sk-proj-prod-...
ANTHROPIC_API_KEY=sk-ant-prod-...
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# Agent Production Flags
USE_BUDGET_MODELS=false

# Observability (validated by @asc/config env schemas)
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-collector-host>:4318

# Medplum (self-hosted, P06). Used from P04. No client secret: the API forwards the signed-in user's token (#57).
# MEDPLUM_BASE_URL=https://<medplum-api-host>/
# Canonical URL base of our FHIR profiles and identifiers. Leave unset: the default is
# https://fhir.wybit.io/asc/. Stored inside every resource, so it must be identical wherever data is shared.
# FHIR_CANONICAL_BASE=https://fhir.wybit.io/asc/
