{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
    "build": "tsup",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/server.js",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@asc/api-client": "workspace:*",
    "@asc/audit": "workspace:*",
    "@asc/authz": "workspace:*",
    "@asc/config": "workspace:*",
    "@asc/db": "workspace:*",
    "@asc/logger": "workspace:*",
    "@asc/telemetry": "workspace:*",
    "@asc/types": "workspace:*",
    "@asc/validation": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@medplum/core": "5.1.42",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.3.3",
    "fastify-sse-v2": "^4.0.0",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@asc/eslint-config": "workspace:*",
    "@asc/typescript-config": "workspace:*",
    "@medplum/mock": "5.1.42",
    "@types/node": "^20",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.0"
  }
}
