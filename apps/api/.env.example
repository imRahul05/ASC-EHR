# Validated at startup by apiEnvSchema in @asc/config (packages/config/src/env.ts)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# App-owned Postgres (@asc/db). Optional until the first agent job persists runs.
# Local docker compose (`pnpm db:up`) — dev-only credentials:
# DATABASE_URL=postgres://asc:asc@localhost:5432/asc_ehr
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Tracing is exported only when NODE_ENV is production/staging AND this is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
