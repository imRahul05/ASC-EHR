# Validated at startup by apiEnvSchema in @asc/config (packages/config/src/env.ts)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Browser origins allowed to call the API (comma-separated, exact, no "*").
# Unset in development/test = http://localhost:3000; unset when deployed = none.
# CORS_ORIGINS=http://localhost:3000
# App-owned Postgres (@asc/db). Optional until the first agent job persists runs.
# Local docker compose (`pnpm db:up`) — dev-only credentials:
# DATABASE_URL=postgres://asc:asc@localhost:5432/asc_ehr
# Runtime role (@asc/db withTenant): NOT the table owner, cannot alter tables or bypass RLS.
# DATABASE_URL above is the OWNER, for migrations only. Local login asc_app: docker/postgres/init/01-runtime-role.sql
# DATABASE_RUNTIME_URL=postgres://asc_app:asc_app@localhost:5432/asc_ehr
# The one configured tenant (uuid) and its Medplum Project. REQUIRED: the API refuses to start without them.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
MEDPLUM_PROJECT_ID=local-project
# Build id (git SHA) recorded in audit decisions. Optional; "unknown" when unset.
# GIT_SHA=
# Flood limits per window (defaults shown): per tenant and address before authentication,
# per tenant and signed-in user after it.
# RATE_LIMIT_IP_MAX=1200
# RATE_LIMIT_USER_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Tracing is exported only when NODE_ENV is production/staging AND this is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
