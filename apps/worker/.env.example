# Validated at startup by workerEnvSchema in @asc/config (packages/config/src/env.ts)
NODE_ENV=development
REDIS_URL=redis://localhost:6379
# App-owned Postgres (@asc/db): agent run records (PHI). Optional until the first agent job persists runs.
# Local docker compose (`pnpm db:up`) — dev-only credentials:
# DATABASE_URL=postgres://asc:asc@localhost:5432/asc_ehr
# Runtime role (@asc/db withTenant): NOT the table owner, cannot alter tables or bypass RLS.
# DATABASE_URL above is the OWNER, for migrations only. Local login asc_app: docker/postgres/init/01-runtime-role.sql
# DATABASE_RUNTIME_URL=postgres://asc_app:asc_app@localhost:5432/asc_ehr
# The one configured tenant (uuid) and its Medplum Project. Required from P05g (StaticTenantResolver).
# DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
# MEDPLUM_PROJECT_ID=<medplum-project-id>
# Queue names are code constants (src/queues.ts): ai-interactive, ai-background.
# Concurrency is per worker process; rate limits are jobs per duration across ALL workers of a queue.
INTERACTIVE_CONCURRENCY=5
INTERACTIVE_RATE_LIMIT_MAX=60
INTERACTIVE_RATE_LIMIT_DURATION_MS=60000
BACKGROUND_CONCURRENCY=2
BACKGROUND_RATE_LIMIT_MAX=20
BACKGROUND_RATE_LIMIT_DURATION_MS=60000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Tracing is exported only when NODE_ENV is production/staging AND this is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
