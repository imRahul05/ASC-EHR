# Validated at startup by workerEnvSchema in @repo/config (packages/config/src/env.ts)
NODE_ENV=development
REDIS_URL=redis://localhost:6379
QUEUE_NAME=default
CONCURRENCY=5
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Tracing is exported only when NODE_ENV is production/staging AND this is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
