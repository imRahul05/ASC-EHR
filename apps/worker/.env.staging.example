# Worker Staging Environment
APP_ENV=staging
NODE_ENV=production
QUEUE_NAME=default
REDIS_URL=rediss://default:<staging_password>@<staging-redis-host>:6379
CONCURRENCY=5

# AI Provider Keys
OPENAI_API_KEY=sk-proj-staging-...
ANTHROPIC_API_KEY=sk-ant-staging-...
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
USE_BUDGET_MODELS=true
